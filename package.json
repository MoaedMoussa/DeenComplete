{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/deen-complete",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "postinstall": "for f in $(find node_modules -name CorsMiddleware.js); do sed -i 's/if (!isSameOrigin && !isAllowedHost)/if (false)/g' $f; sed -i 's/} else if (!isLocalhost && isAllowedHost) {/} else {/g' $f; done"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "overrides": {
    "esbuild": "0.27.3",
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0"
  }
}
